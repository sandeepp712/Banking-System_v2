<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include Spring Boot's default color coding and defaults -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Define our custom pattern with the MDC requestId -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId:-NO-ID}] [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Define the Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ✅ CRITICAL: Explicitly configure JDBC logging here -->
    <!-- This prevents Spring Boot from injecting its default pattern -->
    <logger name="org.springframework.jdbc" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Optional: Configure Hibernate/SQL logs if you ever use JPA -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Set the root logger to INFO, and attach our CONSOLE appender -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>